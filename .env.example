# OKX API配置
OKX_API_KEY=your_okx_api_key_here
OKX_SECRET_KEY=your_okx_secret_key_here
OKX_PASSPHRASE=your_okx_passphrase_here
OKX_SANDBOX=false

# DeepSeek API配置
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 代理配置（可选）
USE_PROXY=false
PROXY_HOST=127.0.0.1
PROXY_PORT=7890
PROXY_TYPE=http

# Server酱通知配置
# 获取SendKey: https://sct.ftqq.com/
SERVERCHAN_SENDKEY=your_serverchan_sendkey_here
# 多个token群发配置（逗号分隔，可选）
# SERVERCHAN_SENDKEYS=token2,token3,token4
ENABLE_SERVERCHAN_NOTIFICATION=true

# WebSocket实时监控配置
ENABLE_WEBSOCKET_MONITOR=false
WEBSOCKET_URL=wss://ws.okx.com:8443/ws/v5/public

# 波动率检测配置
VOLATILITY_THRESHOLD=2.5
VOLATILITY_WINDOW_SIZE=20
VOLUME_SPIKE_MULTIPLIER=3.0

# 实时警报配置
ALERT_COOLDOWN_MINUTES=5
ENABLE_VOLATILITY_ALERTS=true
ENABLE_VOLUME_ALERTS=true

# 交易对配置
# 固定交易对（用逗号分隔，这些交易对会始终包含在分析中）
FIXED_TRADING_PAIRS=BTC-USDT-SWAP,ETH-USDT-SWAP
# 最大分析交易对数量（包含固定交易对）
MAX_TRADING_PAIRS=20
# 最小24小时成交量过滤（USDT）
MIN_VOLUME_24H=1000000

# 分析配置
ANALYSIS_INTERVAL=300
KLINE_LIMIT=300
TIMEFRAME=1h

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=trading_analysis.log

# 风险管理配置
MAX_RISK_PERCENTAGE=2.0
STOP_LOSS_PERCENTAGE=1.5
TAKE_PROFIT_PERCENTAGE=3.0

# WebSocket监控详细配置
WEBSOCKET_SYMBOLS=BTC-USDT-SWAP,ETH-USDT-SWAP
WEBSOCKET_RECONNECT_INTERVAL=5
WEBSOCKET_PING_INTERVAL=20
WEBSOCKET_TIMEOUT=10

# 资金流向监控配置
ENABLE_FUND_FLOW_ALERTS=true
FUND_FLOW_THRESHOLD=1000000
FUND_FLOW_WINDOW_SIZE=100

# 移动止盈配置
ENABLE_MOVING_STOP_PROFIT=true
MAX_GAIN_THRESHOLD=10.0
STOP_LOSS_PERCENT=16.67

# 主力资金监控配置
MAIN_FUND_ESCAPE_THRESHOLD=0.8